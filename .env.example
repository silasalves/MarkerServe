# MarkerServe HTTP service
MARKERSERVE_HOST=127.0.0.1
MARKERSERVE_PORT=8000
LOG_LEVEL=INFO

# external = use an already-running OpenAI-compatible endpoint
# managed = scripts/start.ps1 starts llama-server before MarkerServe
VLM_MODE=external
VLM_BASE_URL=http://127.0.0.1:8080/v1
VLM_REQUIRED=true
VLM_HEALTH_TIMEOUT_SECONDS=3

# Marker options. These names intentionally mirror Marker configuration names.
MARKER_USE_LLM=true
MARKER_MODE=balanced
MARKER_OUTPUT_FORMAT=markdown
MARKER_LLM_SERVICE=marker.services.openai.OpenAIService
MARKER_OPENAI_MODEL=qwen3.5-9b
MARKER_OPENAI_API_KEY=local
MARKER_OPENAI_IMAGE_FORMAT=png
MARKER_FORCE_OCR=true
MARKER_DISABLE_IMAGE_EXTRACTION=true
MARKER_TIMEOUT_SECONDS=600
MARKER_PDFTEXT_WORKERS=1

# Upload/concurrency limits
MAX_UPLOAD_BYTES=52428800
CONVERSION_QUEUE_TIMEOUT_SECONDS=0

# llama.cpp launcher settings. Leave LLAMA_SERVER_BIN blank to auto-discover
# llama-server on PATH or at the locally installed D:\llamacpp\llama-server.exe.
LLAMA_SERVER_BIN=
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
LLAMA_MODELS_PRESET=config/models.ini

# Marker/Surya OCR VLM backend: native llama.cpp or Docker-backed vLLM.
SURYA_INFERENCE_BACKEND=llamacpp
